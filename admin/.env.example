PORT=3000

# Supabase (recommended): Settings → Database → Connection string → URI.
# Append ?sslmode=require — Supabase requires TLS.
# Direct connection (port 5432):
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (small connectors keep them open; port 6543):
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Local default: user-space Postgres on 5433 (see admin/README.md).
# System Postgres often uses 5432 — change host/port/password to match yours.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/mzmur

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@mzmur.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
